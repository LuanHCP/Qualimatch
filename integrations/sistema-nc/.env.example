# Copie para ".env" e ajuste os valores antes de rodar `docker compose up -d --build`.
# Nunca faça commit do arquivo ".env" real (senhas/segredos).

# --- Banco de dados ---
PGDATABASE=nc_sistema
PGUSER=nc_app
PGPASSWORD=troque-esta-senha

# --- Segurança da aplicação ---
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=troque-esta-chave-por-uma-gerada-aleatoriamente
# true em produção atrás de HTTPS (o cookie de sessão só é enviado em conexões seguras)
COOKIE_SECURE=false

# --- Sessão / rate limiting de login ---
SESSION_LIFETIME_MINUTES=480
SESSION_ABSOLUTE_MAX_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Upload ---
MAX_UPLOAD_MB=15

# --- Administrador inicial (bootstrap) ---
# Definidos: o entrypoint cria este admin_geral automaticamente na primeira
# subida (se ainda não existir nenhum admin_geral ativo). Ele é obrigado a
# trocar a senha no primeiro login. Após o primeiro boot, pode remover
# estas duas linhas do .env (o bootstrap não recria/duplica administradores).
BOOTSTRAP_ADMIN_EMAIL=admin@suaempresa.com
# A senha inicial é solicitada pelo instalador e não permanece gravada neste arquivo.
BOOTSTRAP_ADMIN_NOME=Administrador do Sistema

# --- Notificações de novos cadastros ---
ADMIN_NOTIFICATION_EMAIL=admin@qualimatch.local
# No Windows, o sistema tenta usar o Outlook clássico configurado.
EMAIL_USE_OUTLOOK=true
# Alternativamente, configure SMTP corporativo:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PASSWORD_RESET_MINUTES=30
# Opcional para links acessíveis em outra máquina, ex.: https://nc.motiva.com.br
APP_PUBLIC_URL=
